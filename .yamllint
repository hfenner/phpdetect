---
extends: default
rules:
  # Inline PowerShell, shell and Jinja stay in the playbooks for manual reproduction.
  # Enforce YAML correctness without wrapping executable strings to a column limit.
  line-length: disable
  document-start: disable
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
